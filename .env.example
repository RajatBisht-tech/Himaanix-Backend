PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/himaanix
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173

# --- Pay-In Bridge & MoR Configuration ---
PUBLIC_BASE_URL=http://localhost:5000
PAYIN_API_TOKEN=your_secure_payin_api_token
# Existing Himaanix installations may use this equivalent bridge-token name.
HIMAANIX_API_TOKEN=your_secure_payin_api_token
PAYIN_BACKEND_API_ORIGIN=http://localhost:8001
PAYIN_BACKEND_WEBHOOK_URL=http://localhost:8001/api/webhooks/payu/payment

# --- PayU Gateway Credentials ---
PAYU_ENV=test
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt

# --- Razorpay Checkout ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- PhonePe Standard Checkout ---
# PUBLIC_BASE_URL must be a public HTTPS URL for PhonePe redirect callbacks.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=your_phonepe_webhook_username
PHONEPE_WEBHOOK_PASSWORD=your_phonepe_webhook_password

# --- Cashfree Checkout ---
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
